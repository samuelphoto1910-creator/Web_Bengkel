# Environment variables for Sistem Inventory Bengkel Motor
# PRD Configuration: Supabase PostgreSQL + Prisma

# Supabase Transaction Mode Pooler (port 6543) or Session Mode Pooler (port 5432)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection for Prisma Migrations (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Secret key for JWT Session Auth
AUTH_SECRET="super-secret-inventory-bengkel-key-2026-motor"

# Store Information
NEXT_PUBLIC_STORE_NAME="Bengkel Motor Sahabat"
NEXT_PUBLIC_STORE_PHONE="0812-3456-7890"
NEXT_PUBLIC_STORE_ADDRESS="Jl. Raya Otomotif No. 123, Jakarta"
